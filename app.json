{
  "expo": {
    "name": "FiestaApp",
    "slug": "fiestaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FiestaApp usa tus fotos para el flyer de la fiesta",
          "cameraPermission": "FiestaApp usa la cámara para sacar la foto del flyer",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FiestaApp usa tu ubicación para marcar dónde es la fiesta"
        }
      ]
    ]
  }
}
